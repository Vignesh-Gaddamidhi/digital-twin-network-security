datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

// ==========================================
// 1. IDENTITY & ACCESS MANAGEMENT (RBAC)
// ==========================================

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  displayName  String     @map("display_name")
  email        String     @unique
  passwordHash String     @map("password_hash")
  roleId       String     @map("role_id")
  status       UserStatus @default(ACTIVE)
  lastActivity DateTime?  @map("last_activity")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  role         Role       @relation(fields: [roleId], references: [id])
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  assignedAt   DateTime   @default(now()) @map("assigned_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// 2. NETWORK DIGITAL TWIN INVENTORY
// ==========================================

enum PortState {
  OPEN
  CLOSED
  FILTERED
  UNKNOWN
}

model Device {
  id               String            @id
  hostname         String
  deviceType       String            @map("device_type")
  networkZone      String            @map("network_zone")
  primaryIp        String            @map("primary_ip")
  ipAddresses      String[]          @default([]) @map("ip_addresses")
  macAddresses     String[]          @default([]) @map("mac_addresses")
  operatingSystem  String?           @map("operating_system")
  role             String?
  securityState    String            @default("NORMAL") @map("security_state")
  operationalState String            @default("HEALTHY") @map("operational_state")
  riskScore        Float             @default(0.0) @map("risk_score")
  isCompromised    Boolean           @default(false) @map("is_compromised")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  interfaces       DeviceInterface[]
  services         DeviceService[]
  ports            DevicePort[]
  routes           DeviceRoute[]
  vulnerabilities  Vulnerability[]
  outConnections   NetworkConnection[] @relation("SourceDevice")
  inConnections    NetworkConnection[] @relation("DestDevice")
  outEdges         TopologyEdge[]      @relation("SourceEdgeDevice")
  inEdges          TopologyEdge[]      @relation("DestEdgeDevice")
  telemetries      Telemetry[]
  outFlows         TrafficFlow[]       @relation("FlowSourceDevice")
  inFlows          TrafficFlow[]       @relation("FlowDestDevice")
  securityEvents   SecurityEvent[]
  alerts           Alert[]             @relation("AlertDevice")
  predictions      Prediction[]
  temporalPreds    TemporalPrediction[]
  riskAssessments  RiskAssessment[]
  srcAttackPaths   AttackPath[]        @relation("AttackPathSource")
  dstAttackPaths   AttackPath[]        @relation("AttackPathDestination")

  @@map("devices")
}

model DeviceInterface {
  id            String   @id @default(uuid())
  deviceId      String   @map("device_id")
  interfaceName String   @map("interface_name")
  macAddress    String?  @map("mac_address")
  ipAddress     String   @map("ip_address")
  subnet        String?  @default("255.255.255.0")
  gateway       String?
  status        String   @default("UP")
  speed         String?  @default("1Gbps")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, interfaceName])
  @@map("interfaces")
}

model DeviceService {
  id            String   @id @default(uuid())
  deviceId      String   @map("device_id")
  name          String
  protocol      String   @default("TCP")
  port          Int
  status        String   @default("RUNNING")
  version       String?  @default("1.0.0")
  securityState String   @default("NORMAL") @map("security_state")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, name, port, protocol])
  @@map("services")
}

model DevicePort {
  id         String    @id @default(uuid())
  deviceId   String    @map("device_id")
  portNumber Int       @map("port_number")
  protocol   String    @default("TCP")
  state      PortState @default(OPEN)
  service    String?
  exposure   String    @default("INTERNAL")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  device     Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, portNumber, protocol])
  @@map("ports")
}

model DeviceRoute {
  id              String   @id @default(uuid())
  deviceId        String   @map("device_id")
  destinationCidr String   @map("destination_cidr")
  gatewayIp       String   @map("gateway_ip")
  interfaceId     String   @map("interface_id")
  metric          Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")

  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_routes")
}

model NetworkConnection {
  id                  String    @id
  sourceDeviceId      String    @map("source_device_id")
  destinationDeviceId String    @map("destination_device_id")
  protocol            String    @default("TCP")
  sourcePort          Int?      @map("source_port")
  destinationPort     Int?      @map("destination_port")
  status              String    @default("ACTIVE")
  firstSeen           DateTime  @default(now()) @map("first_seen")
  lastSeen            DateTime  @default(now()) @map("last_seen")
  connectionCount     Int       @default(1) @map("connection_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  sourceDevice        Device    @relation("SourceDevice", fields: [sourceDeviceId], references: [id], onDelete: Cascade)
  destDevice          Device    @relation("DestDevice", fields: [destinationDeviceId], references: [id], onDelete: Cascade)

  @@map("connections")
}

model TopologyEdge {
  id                  String   @id
  sourceDeviceId      String   @map("source_device_id")
  destinationDeviceId String   @map("destination_device_id")
  edgeType            String   @default("LOGICAL") @map("edge_type")
  protocol            String   @default("TCP")
  status              String   @default("ACTIVE")
  weight              Float    @default(1.0)
  metadata            Json?    @default("{}")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  sourceDevice        Device   @relation("SourceEdgeDevice", fields: [sourceDeviceId], references: [id], onDelete: Cascade)
  destDevice          Device   @relation("DestEdgeDevice", fields: [destinationDeviceId], references: [id], onDelete: Cascade)

  @@map("topology_edges")
}

// ==========================================
// 3. TELEMETRY & NETWORK FLOWS
// ==========================================
model Telemetry {
  id                 String   @id @default(uuid())
  deviceId           String   @map("device_id")
  timestamp          DateTime @default(now())
  cpuUsage           Float    @map("cpu_usage")
  memoryUsage        Float    @map("memory_usage")
  networkUtilization Float    @default(0.0) @map("network_utilization")
  packetRate         Float    @map("packet_rate")
  byteRate           Float    @map("byte_rate")
  activeConnections  Int      @default(0) @map("active_connections")
  securityState      String   @default("NORMAL") @map("security_state")
  riskScore          Float    @default(0.0) @map("risk_score")
  source             String   @default("TWIN_AGENT")

  device             Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@map("telemetry")
}

model TrafficFlow {
  id                  String   @id @default(uuid())
  timestamp           DateTime @default(now())
  sourceDeviceId      String?  @map("source_device_id")
  destinationDeviceId String?  @map("destination_device_id")
  sourceIp            String   @map("source_ip")
  destinationIp       String   @map("destination_ip")
  sourcePort          Int      @map("source_port")
  destinationPort     Int      @map("destination_port")
  protocol            String   @default("TCP")
  packetCount         Int      @map("packet_count")
  byteCount           BigInt   @map("byte_count")
  flowDuration        Float    @default(0.0) @map("flow_duration")
  connectionCount     Int      @default(1) @map("connection_count")
  status              String   @default("ESTABLISHED")

  sourceDevice        Device?  @relation("FlowSourceDevice", fields: [sourceDeviceId], references: [id], onDelete: SetNull)
  destDevice          Device?  @relation("FlowDestDevice", fields: [destinationDeviceId], references: [id], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([sourceIp, destinationIp])
  @@index([protocol])
  @@index([destinationPort])
  @@map("traffic_flows")
}

// ==========================================
// 4. SECURITY EVENTS, IDS & ALERTS
// ==========================================
model SecurityEvent {
  eventId         String   @id @map("event_id")
  timestamp       DateTime @default(now())
  source          String
  destination     String
  deviceId        String?  @map("device_id")
  protocol        String   @default("TCP")
  port            Int?
  eventType       String   @map("event_type")
  severity        String   @default("INFO")
  detectionSource String   @map("detection_source")
  detectionType   String   @map("detection_type")
  confidence      Float    @default(1.0)
  evidence        String?
  status          String   @default("UNRESOLVED")
  createdAt       DateTime @default(now()) @map("created_at")

  device          Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  idsEvents       IdsEvent[]
  alerts          Alert[]

  @@index([timestamp(sort: Desc)])
  @@index([deviceId])
  @@index([eventType])
  @@index([severity])
  @@map("security_events")
}

model IdsEvent {
  id              String         @id @default(uuid())
  timestamp       DateTime       @default(now())
  source          String
  destination     String
  protocol        String         @default("TCP")
  port            Int?
  signature       String
  signatureId     Int            @map("signature_id")
  severity        String         @default("HIGH")
  category        String         @default("ATTEMPTED_ADMIN")
  sensor          String         @default("SURICATA")
  rawReference    String?        @map("raw_reference")
  securityEventId String?        @map("security_event_id")

  securityEvent   SecurityEvent? @relation(fields: [securityEventId], references: [eventId], onDelete: SetNull)

  @@index([timestamp(sort: Desc)])
  @@index([signatureId])
  @@index([sensor])
  @@map("ids_events")
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  INVESTIGATING
  RESOLVED
  FALSE_POSITIVE
  CLOSED
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

model Alert {
  alertId           String        @id @map("alert_id")
  timestamp         DateTime      @default(now())
  source            String
  destination       String
  protocol          String        @default("TCP")
  port              Int?
  eventType         String        @map("event_type")
  severity          String        @default("MEDIUM")
  detectionSource   String        @map("detection_source")
  detectionType     String        @map("detection_type")
  confidence        Float         @default(1.0)
  riskScore         Float         @default(0.0) @map("risk_score")
  riskLevel         String        @default("MEDIUM") @map("risk_level")
  affectedDeviceId  String        @map("affected_device_id")
  status            AlertStatus   @default(NEW)
  evidence          String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  incidentId        String?       @map("incident_id")
  securityEventId   String?       @map("security_event_id")

  affectedDevice    Device        @relation("AlertDevice", fields: [affectedDeviceId], references: [id], onDelete: Cascade)
  incident          Incident?     @relation(fields: [incidentId], references: [incidentId], onDelete: SetNull)
  securityEvent     SecurityEvent? @relation(fields: [securityEventId], references: [eventId], onDelete: SetNull)
  predictions       Prediction[]

  @@index([timestamp(sort: Desc)])
  @@index([severity])
  @@index([status])
  @@index([affectedDeviceId])
  @@map("alerts")
}

model Incident {
  incidentId        String         @id @map("incident_id")
  title             String
  description       String?
  severity          String         @default("HIGH")
  status            IncidentStatus @default(OPEN)
  assignedOperator  String?        @map("assigned_operator")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  alerts            Alert[]
  predictions       Prediction[]
  riskAssessments   RiskAssessment[]
  attackPaths       AttackPath[]

  @@index([status])
  @@index([severity])
  @@index([createdAt(sort: Desc)])
  @@map("incidents")
}

// ==========================================
// 5. ML PREDICTIONS, TEMPORAL & XAI
// ==========================================

enum ThreatWarningStatus {
  NO_WARNING
  WATCH
  EARLY_WARNING
  HIGH_CONFIDENCE_WARNING
  IMPACT_STAGE
}

model Prediction {
  predictionId        String         @id @map("prediction_id")
  timestamp           DateTime       @default(now())
  deviceId            String         @map("device_id")
  source              String?
  destination         String?
  threatProbability   Float          @map("threat_probability")
  threatClass         String         @map("threat_class")
  predictedCategory   String         @map("predicted_category")
  categoryConfidence  Float          @map("category_confidence")
  riskScore           Float          @default(0.0) @map("risk_score")
  riskLevel           String         @default("MEDIUM") @map("risk_level")
  modelName           String         @map("model_name")
  modelVersion        String         @map("model_version")
  featureVersion      String         @default("v1.0") @map("feature_version")
  evidence            String?
  predictionStatus    String         @default("ACTIVE") @map("prediction_status")

  alertId             String?        @map("alert_id")
  incidentId          String?        @map("incident_id")

  device              Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  alert               Alert?         @relation(fields: [alertId], references: [alertId], onDelete: SetNull)
  incident            Incident?      @relation(fields: [incidentId], references: [incidentId], onDelete: SetNull)
  xaiExplanation      XaiExplanation?

  @@index([deviceId])
  @@index([timestamp(sort: Desc)])
  @@index([predictedCategory])
  @@map("predictions")
}

model TemporalPrediction {
  predictionId             String              @id @map("prediction_id")
  timestamp                DateTime            @default(now())
  deviceId                 String              @map("device_id")
  currentThreatProbability Float               @map("current_threat_probability")
  futureThreatProbability  Float               @map("future_threat_probability")
  predictionHorizon        String              @default("30s") @map("prediction_horizon")
  leadTime                 Float               @map("lead_time")
  impactStage              String              @map("impact_stage")
  warningStatus            ThreatWarningStatus @default(WATCH) @map("warning_status")
  modelName                String              @map("model_name")
  modelVersion             String              @map("model_version")
  featureVersion           String              @default("v1.0") @map("feature_version")

  device                   Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([warningStatus])
  @@index([timestamp(sort: Desc)])
  @@map("temporal_predictions")
}

model XaiExplanation {
  explanationId         String     @id @default(uuid()) @map("explanation_id")
  predictionId          String     @unique @map("prediction_id")
  timestamp             DateTime   @default(now())
  modelName             String     @map("model_name")
  modelVersion          String     @map("model_version")
  baseValue             Float      @map("base_value")
  predictionProbability Float      @map("prediction_probability")
  featureValues         Json       @map("feature_values")
  featureImportance     Json       @map("feature_importance")
  shapContributions     Json       @map("shap_contributions")
  humanExplanation      String     @map("human_explanation")
  explanationType       String     @default("TreeSHAP") @map("explanation_type")

  prediction            Prediction @relation(fields: [predictionId], references: [predictionId], onDelete: Cascade)

  @@map("xai_explanations")
}

// ==========================================
// 6. QUANTITATIVE RISK & ATTACK PATHS
// ==========================================

model RiskAssessment {
  riskId              String    @id @default(uuid()) @map("risk_id")
  timestamp           DateTime  @default(now())
  deviceId            String    @map("device_id")
  threatProbability   Float     @map("threat_probability")
  assetCriticality    Float     @map("asset_criticality")
  vulnerabilityFactor Float     @map("vulnerability_factor")
  attackImpact        Float     @map("attack_impact")
  riskScore           Float     @map("risk_score")
  riskLevel           String    @map("risk_level")
  source              String    @default("CANONICAL_ENGINE")

  incidentId          String?   @map("incident_id")

  device              Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  incident            Incident? @relation(fields: [incidentId], references: [incidentId], onDelete: SetNull)

  @@index([deviceId])
  @@index([riskLevel])
  @@index([timestamp(sort: Desc)])
  @@map("risk_assessments")
}

enum AttackPathStatus {
  POSSIBLE
  ACTIVE_SIMULATED
  BLOCKED
  MITIGATED
  HISTORICAL
  UNVERIFIED
}

model AttackPath {
  attackPathId        String           @id @map("attack_path_id")
  timestamp           DateTime         @default(now())
  sourceDeviceId      String           @map("source_device_id")
  destinationDeviceId String           @map("destination_device_id")
  path                String[]         @default([])
  riskScore           Float            @map("risk_score")
  vulnerabilities     String[]         @default([])
  exposure            String           @default("INTERNAL")
  reachability        String           @default("POSSIBLE")
  status              AttackPathStatus @default(POSSIBLE)
  evidence            String?

  incidentId          String?          @map("incident_id")

  sourceDevice        Device           @relation("AttackPathSource", fields: [sourceDeviceId], references: [id], onDelete: Cascade)
  destinationDevice   Device           @relation("AttackPathDestination", fields: [destinationDeviceId], references: [id], onDelete: Cascade)
  incident            Incident?        @relation(fields: [incidentId], references: [incidentId], onDelete: SetNull)

  @@index([status])
  @@index([riskScore(sort: Desc)])
  @@index([sourceDeviceId, destinationDeviceId])
  @@map("attack_paths")
}

// ==========================================
// 7. SIMULATION & VULNERABILITIES
// ==========================================
model SimulationRun {
  id              String    @id
  scenarioType    String    @map("scenario_type")
  status          String    @default("COMPLETED")
  speedMultiplier Float     @default(1.0) @map("speed_multiplier")
  horizonSeconds  Int       @default(30) @map("horizon_seconds")
  eventsEmitted   Int       @default(0) @map("events_emitted")
  startedAt       DateTime  @default(now()) @map("started_at")
  completedAt     DateTime? @map("completed_at")

  @@map("simulation_runs")
}

model Vulnerability {
  id              String   @id
  deviceId        String   @map("device_id")
  cveId           String   @map("cve_id")
  severity        String
  cvssScore       Float    @map("cvss_score")
  description     String?
  status          String   @default("OPEN")
  remediation     String?
  discoveredAt    DateTime @default(now()) @map("discovered_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("vulnerabilities")
}

// ==========================================
// 8. GOVERNANCE & FORENSIC AUDIT TRAIL
// ==========================================
model AuditLog {
  id             String   @id
  timestamp      DateTime @default(now())
  operator       String
  action         String
  objectType     String   @map("object_type")
  objectId       String   @map("object_id")
  previousState  String?  @map("previous_state")
  newState       String   @map("new_state")
  mode           String   @default("SIMULATION")
  result         String   @default("SUCCESS")
  reason         String?
  userId         String?  @map("user_id")

  user           User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}